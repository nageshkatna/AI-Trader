# Postgres (Lambda uses DATABASE_URL from env / Secrets Manager)
DATABASE_URL=postgres://trader:trader@localhost:5432/ai_trader

# Price providers
PRICE_PROVIDER=yahoo
# ALPHA_VANTAGE_API_KEY=

# News provider (NewsAPI.org or similar)
# NEWS_API_KEY=
NEWS_QUERY=stock market OR equities OR earnings

# Universe pulled on each EventBridge tick
SYMBOLS=AAPL,MSFT,GOOGL,AMZN,NVDA

# Shared secret for POST /ingest from the local MT4 uploader
INGEST_API_KEY=change-me

# Optional: lookback window for scheduled pulls
PRICE_LOOKBACK_DAYS=7
NEWS_LOOKBACK_HOURS=24
