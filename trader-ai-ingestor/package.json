{
  "name": "trader-ai-ingestor",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud data ingestion layer: AWS Lambda + EventBridge + Postgres",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "sam:build": "sam build",
    "sam:local:prices": "sam local invoke IngestPricesFunction --event events/eventbridge-prices.json",
    "sam:local:news": "sam local invoke IngestNewsFunction --event events/eventbridge-news.json",
    "sam:local:api": "sam local start-api",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.699.0",
    "pg": "^8.13.1",
    "yahoo-finance2": "^2.13.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
