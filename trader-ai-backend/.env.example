# Application
APP_NAME="AI Trader Backend"
APP_VERSION="0.1.0"
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS - Frontend URL
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_trader_db
# For SQLite (development):
# DATABASE_URL=sqlite:///./ai_trader.db

# LLM API Keys (uncomment the one you're using)
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Market Data API Keys
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
# POLYGON_API_KEY=your_polygon_key_here

# Session Management
SESSION_SECRET_KEY=your-super-secret-key-change-this-in-production

# Logging
LOG_LEVEL=INFO
